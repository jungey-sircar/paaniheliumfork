import("//ui/webui/resources/tools/build_webui.gni")

build_webui("build") {
  grd_prefix = "paani"

  static_files = [ "paani.html" ]

  css_files = [ "app.css" ]

  # `web_component_files` also picks up the template with the same base name
  # (app.html), which build_webui turns into app.html.js for getHtml().
  web_component_files = [ "app.ts" ]

  mojo_files_deps = [
    "//chrome/browser/ui/webui/paani:mojo_bindings_ts__generator",
  ]
  mojo_files = [ "$root_gen_dir/chrome/browser/ui/webui/paani/paani.mojom-webui.ts" ]

  ts_deps = [
    "//third_party/lit/v3_0:build_ts",
    "//ui/webui/resources/cr_elements:build_ts",
    "//ui/webui/resources/js:build_ts",
    "//ui/webui/resources/mojo:build_ts",
  ]
  ts_composite = true
  webui_context_type = "trusted"
}
