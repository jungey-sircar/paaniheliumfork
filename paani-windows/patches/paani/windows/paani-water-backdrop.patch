+
+bool BrowserFrameViewWin::PaintPaaniChromeBackdrop(gfx::Canvas* canvas) {
+  if (!helium::ShouldUseNativeFrameMaterials(GetBrowserView())) {
+    return false;
+  }
+
+  // Under native materials every view in this band declines to paint a
+  // background of its own, so one draw behind all of them is the whole
+  // translucent chrome: titlebar, tab strip, toolbar and bookmark bar.
+  // The tabs themselves blend their tab colour towards transparent, so
+  // they read as frosted over this rather than sitting on black.
+  int bottom = TitlebarHeight(false);
+  if (views::View* top_container = GetBrowserView()->top_container()) {
+    gfx::Point container_bottom =
+        top_container->GetLocalBounds().bottom_right();
+    views::View::ConvertPointToTarget(top_container, this,
+                                     &container_bottom);
+    bottom = std::max(bottom, container_bottom.y());
+  }
+
+  // A desktop with no readable wallpaper is answered with a solid frame,
+  // which is what the fallback in the paint helper already does.
+  paani::PaintChromeBackdrop(canvas, this,
+                               gfx::Rect(0, 0, width(), bottom),
+                               GetFrameColor(BrowserFrameActiveState::
+                                             kUseCurrent));
+  return true;
 }
 
