 #include "chrome/browser/payments/payment_request_display_manager_factory.h"
 #include "chrome/browser/performance_manager/public/chrome_browser_main_extra_parts_performance_manager.h"
 #include "chrome/browser/performance_manager/public/chrome_content_browser_client_performance_manager_part.h"
@@ -6808,6 +6809,21 @@
     network::mojom::URLLoaderFactoryOverridePtr* factory_override,
     scoped_refptr<base::SequencedTaskRunner> navigation_response_task_runner,
     bool is_for_network_service) {
+  // Install the Paani built in ad blocker. It blocks the subresources of a
+  // document that the filter lists match.
+  //
+  // This is deliberately the first interceptor in the chain. Every factory
+  // appended later only ever sees the requests this one let through, and
+  // Helium's uBlock Origin component extension registers its webRequest proxy
+  // immediately below. Behind it, Paani is asked only about requests uBlock
+  // already allowed, which makes the blocked-request counter it shows the user
+  // meaningless even though the filter engine itself is loaded and working.
+  if (type == URLLoaderFactoryType::kDocumentSubResource ||
+      type == URLLoaderFactoryType::kWorkerSubResource) {
+    paani::PaaniAdblockURLLoaderFactory::MaybeProxyRequest(
+        browser_context, frame, factory_builder);
+  }
+
