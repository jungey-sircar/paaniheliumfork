+++ b/third_party/rust/adblock/v0_13/BUILD.gn
@@ -90,10 +90,8 @@
   ]
   features = [
     "addr",
-    "default",
     "embedded-domain-resolver",
     "full-regex-handling",
-    "single-thread",
   ]
 
   #####################################################################
