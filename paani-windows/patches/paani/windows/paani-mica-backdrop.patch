 ///////////////////////////////////////////////////////////////////////////////
 // BrowserFrameViewWin, private:
+
+void BrowserFrameViewWin::UpdateNativeFrameBackdrop() {
+  HWND hwnd = views::HWNDForWidget(browser_widget());
+  if (!hwnd) {
+    return;
+  }
+
+  // Mica is the desktop material Windows 11 uses behind a normal window;
+  // none of this happens unless the native frame materials are on, which
+  // already bails out on reduced transparency and forced colours.
+  const DWORD backdrop =
+      helium::ShouldUseNativeFrameMaterials(GetBrowserView())
+          ? DWMSBT_MAINWINDOW
+          : DWMSBT_NONE;
+  if (applied_system_backdrop_.has_value() &&
+      applied_system_backdrop_.value() == backdrop) {
+    return;
+  }
+
+  if (SUCCEEDED(::DwmSetWindowAttribute(hwnd, DWMWA_SYSTEMBACKDROP_TYPE,
+                                         &backdrop, sizeof(backdrop)))) {
+    applied_system_backdrop_ = backdrop;
+  }
+}
 
